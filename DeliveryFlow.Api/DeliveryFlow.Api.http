### 04.8 Cannot start nonexistent order
POST {{baseUrl}}/api/orders/{{missingOrderId}}/start-delivery
Accept: application/json

> {%
    client.test("Start missing order: 404 Not Found", function () {
        client.assert(response.status === 404, "Expected HTTP 404");
    });
%}

### 04.9 Cannot complete nonexistent order
POST {{baseUrl}}/api/orders/{{missingOrderId}}/complete-delivery
Accept: application/json

> {%
    client.test("Complete missing order: 404 Not Found", function () {
