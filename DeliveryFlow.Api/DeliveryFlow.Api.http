### 04.7 Cannot assign courier to nonexistent order
POST {{baseUrl}}/api/orders/{{missingOrderId}}/assign
Content-Type: application/json
Accept: application/json

{
  "courierId": "{{missingCourierId}}"
}

> {%
    client.test("Assign missing order: 404 Not Found", function () {
        client.assert(response.status === 404, "Expected HTTP 404");
    });
