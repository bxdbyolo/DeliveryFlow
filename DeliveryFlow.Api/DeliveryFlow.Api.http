        client.assert(response.status === 404, "Expected HTTP 404");
    });
%}

### 04.6 Cannot cancel nonexistent order
POST {{baseUrl}}/api/orders/{{missingOrderId}}/cancel
Accept: application/json

> {%
    client.test("Cancel missing order: 404 Not Found", function () {
